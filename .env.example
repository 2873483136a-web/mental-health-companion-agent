# 复制为 .env 并填入你自己的 DeepSeek Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- SSL（可选）----
# 默认用 certifi 证书包，一般无需配置。
# 若身处会做 TLS 拦截的公司代理网络仍报 CERTIFICATE_VERIFY_FAILED，二选一：
# DEEPSEEK_CA_BUNDLE=/绝对路径/公司根证书.pem   # 推荐：指定公司根证书
# DEEPSEEK_VERIFY_SSL=false                      # 仅本地调试用，关闭校验（不安全）
